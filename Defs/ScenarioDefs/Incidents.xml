<?xml version="1.0" encoding="utf-8" ?>
<Defs>

<IncidentDef>
    <defName>HSK_MarkerImpact</defName>
    <label>marker impact</label>
    <category>Misc</category>
    <targetTags>
      <li>Map_PlayerHome</li>
    </targetTags>
    <workerClass>HSK.Watcher.DeadSpace.IncidentWorker_MarkerImpact</workerClass>
    <baseChance>1.0</baseChance>
    <earliestDay>20</earliestDay>
    <letterLabel>Marker impact</letterLabel>
    <letterText>Something fell from the sky. A blinding flash, a shockwave, and when the dust settled, a black obelisk was standing where the explosion had been. It does not look like anything built by human hands.</letterText>
    <letterDef>NegativeEvent</letterDef>
  </IncidentDef>
  
  <IncidentDef>
    <defName>HSK_InfectorOutbreak</defName>
    <label>infector outbreak</label>
    <category>Misc</category>
    <targetTags>
      <li>Map_PlayerHome</li>
    </targetTags>
    <workerClass>HSK.Watcher.DeadSpace.IncidentWorker_InfectorOutbreak</workerClass>
    <baseChance>0.4</baseChance>
    <minRefireDays>15</minRefireDays>
    <letterLabel>Infector outbreak</letterLabel>
    <letterText>The marker's signal has reached the dead. Where the corpses lie together, the ground has split and thin, long-limbed creatures are crawling out. They are looking for bodies to continue.\n\nAn obelisk sculpture standing in the colony would have drowned out the signal.</letterText>
      <letterDef>NegativeEvent</letterDef>
  </IncidentDef>
  
  <IncidentDef>
    <defName>HSK_UnitologyWhispers</defName>
    <label>whispers from the void</label>
    <category>Misc</category>
    <targetTags>
      <li>Map_PlayerHome</li>
    </targetTags>
    <workerClass>HSK.Watcher.DeadSpace.IncidentWorker_UnitologyWhispers</workerClass>
    <baseChance>0.5</baseChance>
    <minRefireDays>15</minRefireDays>
    <earliestDay>10</earliestDay>
	<letterDef>NegativeEvent</letterDef>
  </IncidentDef>
  
  
  <IncidentDef>
    <defName>HSK_MarkerStrike</defName>
    <label>CEC marker strike team</label>
    <category>ThreatBig</category>
    <targetTags>
      <li>Map_PlayerHome</li>
    </targetTags>
    <workerClass>HSK.Watcher.DeadSpace.IncidentWorker_MarkerStrike</workerClass>
    <baseChance>0.6</baseChance>
    <minRefireDays>40</minRefireDays>
    <earliestDay>15</earliestDay>
    <modExtensions>
      <li Class="HSK.Watcher.DeadSpace.MarkerStrikeExtension">
        <armorDef>Armor_CEC</armorDef>
        <helmetDef>Helmet_CEC</helmetDef>
        <shuttleDef>HSK_CECShuttle</shuttleDef>
        <shuttleIncomingDef>HSK_CECShuttleIncoming</shuttleIncomingDef>
        <shuttleLeavingDef>HSK_CECShuttleLeaving</shuttleLeavingDef>
        <!-- stock of ammo varies by +-10% per trooper (0 = exact) -->
        <ammoSpread>0.1</ammoSpread>
        <!-- optional: your own PawnKindDef; otherwise AncientSoldier / Mercenary_Gunner is used -->
        <!-- <pawnKind>HSK_CECTrooper</pawnKind> -->
        <members>
          <li>
            <weaponDef>Gun_PulseRifle</weaponDef>
            <ammoCount>1000</ammoCount>
          </li>
          <li>
            <weaponDef>Gun_PulseRifle</weaponDef>
            <ammoCount>1000</ammoCount>
          </li>
          <li>
            <weaponDef>Gun_DiscRipper</weaponDef>
            <ammoCount>120</ammoCount>
          </li>
          <li>
            <weaponDef>Gun_ContactBeam</weaponDef>
            <ammoCount>50</ammoCount>
          </li>
          <li>
            <weaponDef>Gun_PlasmaCutter</weaponDef>
            <ammoCount>400</ammoCount>
          </li>
        </members>
      </li>
    </modExtensions>
  </IncidentDef>
</Defs>

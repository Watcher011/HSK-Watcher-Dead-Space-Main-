    <ThingDef ParentName="BaseGun_ShortBarreled">
        <defName>Gun_PlasmaCutter</defName>
        <label>Plasma cutter</label>
        <description>The plasma cutter is a mining tool designed for processing rock. Due to its unexpected effectiveness against Necromorphs in the region, the plasma cutter has become one of the primary tools for survival during the outbreak.</description>
        <graphicData>
            <texPath>Things/Item/Weapons/PlasmaCutter</texPath>
            <graphicClass>Graphic_Single</graphicClass>
        </graphicData>
        <statBases>
            <MarketValue>2600</MarketValue>
            <SightsEfficiency>1.15</SightsEfficiency>
            <ShotSpread>0.06</ShotSpread>
            <SwayFactor>1.05</SwayFactor>
            <RangedWeapon_Cooldown>0.65</RangedWeapon_Cooldown>
            <Bulk>3.20</Bulk>
            <Mass>1.50</Mass>
        </statBases>
        <tradeability>Sellable</tradeability>
        <soundInteract>InteractPlasma</soundInteract>
		<techLevel>Spacer</techLevel>
		 <equippedStatOffsets>
            <ConstructionSpeed>0.35</ConstructionSpeed>
            <SmithingSpeed>0.3</SmithingSpeed>
            <MeleeCritChance>0.22</MeleeCritChance>
        </equippedStatOffsets>
        <weaponTags>
            <li>ADP2</li>
            <li>AdvancedGun</li>
            <li>TierTwoLow</li>
            <li>Futuristic</li>
		  <li>CE_Sidearm</li>
		  <li>CE_AI_Pistol</li>
		  <li>CE_OneHandedWeapon</li>
        </weaponTags>
		<weaponClasses>
			<li>Ultratech</li>
			<li>RangedLight</li>
		</weaponClasses>
        <thingCategories>
            <li>Futuristic</li>
        </thingCategories>
        <verbs>
            <li Class="CombatExtended.VerbPropertiesCE">
                <verbClass>CombatExtended.Verb_ShootCE</verbClass>
                <hasStandardCommand>true</hasStandardCommand>
                <defaultProjectile>Bullet_PlasmaClot</defaultProjectile>
                <warmupTime>0.52</warmupTime>
                <range>45</range>
                <soundCast>Fire_UACPistol</soundCast>
                <soundCastTail>GunTail_Medium</soundCastTail>
                <muzzleFlashScale>9</muzzleFlashScale>
            </li>
        </verbs>
        <comps>
            <li Class="CombatExtended.CompProperties_FireModes">
                <aiUseBurstMode>FALSE</aiUseBurstMode>
                <aiAimMode>AimedShot</aiAimMode>
            </li>
            <li Class="CombatExtended.CompProperties_AmmoUser">
                <magazineSize>25</magazineSize>
                <reloadTime>1.80</reloadTime>
                <ammoSet>AmmoSet_PlasmaClot</ammoSet>
            </li>
        </comps>
        <smeltProducts>
            <Plasma_Component>1</Plasma_Component>
            <Weapon_Parts>4</Weapon_Parts>
			<Plastic>5</Plastic>
        </smeltProducts>
		<thingSetMakerTags>
			<li>RewardStandardLowFreq</li>
			<li>RewardStandardQualitySuper</li>
		</thingSetMakerTags>
    </ThingDef>
	
	
	<RecipeDef ParentName="RangedWeaponRecipeBase">
		<defName>BuildGun_PlasmaCutter</defName>
		<label>Build Plasma Cutter</label>
		<description>Builds an Plasma Cutter. Good range, good power and low rate of fire.</description>
		<jobString>Building Plasma Cutter.</jobString>
		<workAmount>12200</workAmount>
		<skillRequirements>
			<Crafting>3</Crafting>
		</skillRequirements>
		<ingredients>
			<li>
				<filter>
					<thingDefs>
						<li>Electronics</li>
					</thingDefs>
				</filter>
				<count>4</count>
			</li>
			<li>
				<filter>
					<thingDefs>
						<li>Weapon_Parts</li>
					</thingDefs>
				</filter>
				<count>10</count>
			</li>
			<li>
				<filter>
					<thingDefs>
						<li>ComponentIndustrial</li>
					</thingDefs>
				</filter>
				<count>6</count>
			</li>
			<li>
				<filter>
					<categories>
						<li>Metallic</li>
					</categories>
				</filter>
				<count>20</count>
			</li>
			<li>
				<filter>
			  <categories>
				<li>SLDBar</li>
				<li>USLDBar</li>
			  </categories>
			</filter>
			<count>20</count>
			</li>
		</ingredients>
		<products>
			<Gun_PlasmaCutter>1</Gun_PlasmaCutter>
		</products>
		<fixedIngredientFilter>
			<thingDefs>
				<li>Electronics</li>
				<li>Weapon_Parts</li>
				<li>ComponentIndustrial</li>
			</thingDefs>
			<categories>
				<li>SLDBar</li>
				<li>USLDBar</li>
				<li>Leathers</li>
			</categories>
		</fixedIngredientFilter>
		<recipeUsers>
			<li>WeaponCraftingWorkTable</li>
			<li>AdvWeaponCraftingWorkTable</li>
		</recipeUsers>
	    <researchPrerequisite>Rifles_C1</researchPrerequisite>
	</RecipeDef>
	
	<ThingDef ParentName="BaseGun_Heavy">
		<defName>Gun_PulseRifle</defName>
		<label>Pulse Rifle</label>

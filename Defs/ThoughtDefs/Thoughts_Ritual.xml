<?xml version="1.0" encoding="utf-8" ?>
<Defs>
 <ThoughtDef>
    <defName>HSK_Unitology_DeadNearby</defName>
    <workerClass>HSK.Watcher.DeadSpace.ThoughtWorker_Precept_CorpsesNearby</workerClass>
    <stages>
      <li>
        <label>the dead are near</label>
        <description>The dead lie close. Convergence is near, and they are its first fruit.</description>
        <baseMoodEffect>4</baseMoodEffect>
      </li>
      <li>
        <label>a congregation of the dead</label>
        <description>So many of the dead gathered together. This is what a holy place feels like.</description>
        <baseMoodEffect>8</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>
 
  <ThoughtDef>
    <defName>HSK_Unitology_NearMarker</defName>
    <workerClass>HSK.Watcher.DeadSpace.ThoughtWorker_Precept_MarkerNearby</workerClass>
    <stages>
      <li>
        <label>in the shadow of the marker</label>
        <description>The marker is close. Its signal is faint, but I can almost hear it.</description>
        <baseMoodEffect>5</baseMoodEffect>
      </li>
      <li>
        <label>in the light of the awakened marker</label>
        <description>The marker is awake. The signal fills me. This is why we live.</description>
        <baseMoodEffect>12</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

 
  <ThoughtDef>
    <defName>HSK_UnitologyWhisper</defName>
    <thoughtClass>HSK.Watcher.DeadSpace.Thought_UnitologyWhisper</thoughtClass>
    <durationDays>4</durationDays>
    <stackLimit>1</stackLimit>
    <stackedEffectMultiplier>1</stackedEffectMultiplier>
    <stages>
      <li>
        <label>whisper</label>
        <description>A voice from the void.</description>
        <baseMoodEffect>-5</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>
</Defs>

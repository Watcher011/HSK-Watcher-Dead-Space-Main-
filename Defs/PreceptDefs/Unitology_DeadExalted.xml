<?xml version="1.0" encoding="utf-8" ?>
<Defs>
<PreceptDef>
    <defName>HSK_Unitology_DeadExalted</defName>
    <issue>Corpses</issue>
    <label>the dead exalted</label>
    <description>The dead are the first to be made whole. Followers are comforted by corpses and graves nearby and feel no horror at the sight of them.</description>
    <impact>Medium</impact>
    <displayOrderInIssue>10</displayOrderInIssue>
    <displayOrderInImpact>10</displayOrderInImpact>
    <requiredMemes>
      <li>HSK_Unitology</li>
    </requiredMemes>
    <comps>
      <li Class="PreceptComp_SituationalThought">
        <thought>HSK_Unitology_DeadNearby</thought>
      </li>
    </comps>
  </PreceptDef>
 
  <!-- Frequent conversion -->
  <PreceptDef>
    <defName>HSK_Unitology_Convergence</defName>
    <issue>HSK_UnitologyDoctrine</issue>
    <label>spread the word</label>
    <description>Every soul must hear the signal. Followers preach constantly, and their words are far more persuasive. Near a studied marker their zeal is stronger still.</description>
    <impact>Medium</impact>
    <displayOrderInIssue>20</displayOrderInIssue>
    <displayOrderInImpact>20</displayOrderInImpact>
    <requiredMemes>
      <li>HSK_Unitology</li>
    </requiredMemes>
    <statFactors>
      <ConversionPower>1.75</ConversionPower>
    </statFactors>
    <comps>
      <li Class="PreceptComp_SituationalThought">
        <thought>HSK_Unitology_NearMarker</thought>
      </li>
    </comps>
  </PreceptDef>
  
   <PreceptDef>
    <defName>HSK_IdeoBuilding_Marker</defName>
    <label>marker altar</label>
    <description>A building of ideoligious significance: a small copy of the black marker. Only unitologists can build it. It may be used as a focus for rituals.</description>
    <issue>IdeoBuilding</issue>
    <preceptClass>Precept_Building</preceptClass>
    <workerClass>PreceptWorker_Building</workerClass>
    <nameMaker>NamerIdeoBuilding</nameMaker>
    <impact>Medium</impact>
    <requiredMemes>
      <li>HSK_Unitology</li>
    </requiredMemes>
    <buildingDefChances>
      <HSK_Altar_MarkerSmall>1</HSK_Altar_MarkerSmall>
    </buildingDefChances>
    <useChoicesFromBuildingDefs>true</useChoicesFromBuildingDefs>
    <allowDuplicates>false</allowDuplicates>
    <countsTowardsPreceptLimit>false</countsTowardsPreceptLimit>
    <maxCount>1</maxCount>
    <!-- Поля ниже скопированы из ванильного IdeoBuilding: без них Precept_Building падает с NRE при отрисовке/генерации -->
    <buildingMinExpectations>
      <li>Moderate</li>
      <li>High</li>
    </buildingMinExpectations>
    <preceptInstanceCountCurve>
      <points>
        <li>(0.5, 1)</li>
        <li>(1.0, 1)</li>
      </points>
    </preceptInstanceCountCurve>
    <roomRequirementCountCurve>
      <points>
        <li>(0.5, 1)</li>
        <li>(1.0, 2)</li>
      </points>
    </roomRequirementCountCurve>
    <buildingRoomRequirements>
      <li Class="RoomRequirement_Area">
        <area>25</area>
      </li>
      <li Class="RoomRequirement_TerrainWithTags">
        <labelKey>RoomRequirementAllFloored</labelKey>
        <tags>
          <li>Floor</li>
          <li>FineFloor</li>
        </tags>
      </li>
      <li Class="RoomRequirement_Impressiveness">
        <impressiveness>60</impressiveness>
      </li>
      <li Class="RoomRequirement_ThingCount">
        <thingDef>HSK_ObeliskSculpture</thingDef>
        <count>4</count>
      </li>
    </buildingRoomRequirements>
    <buildingRoomRequirementsFixed>
      <li Class="RoomRequirement_ForbiddenBuildings">
        <labelKey>RoomRequirementNoBeds</labelKey>
        <buildingTags><li>Bed</li></buildingTags>
      </li>
      <li Class="RoomRequirement_ForbiddenBuildings">
        <labelKey>RoomRequirementNoProductionFacilities</labelKey>
        <buildingTags><li>Production</li></buildingTags>
      </li>
    </buildingRoomRequirementsFixed>
  </PreceptDef>
  
  
<!--  добавить маркеру что то на подобии поглащения древа предвесника , но чтоб колонисты несли труппы к маркеру , а там будет заполнятся шкала восхождения , при заполнении , на карте появляются некроморфы /заразители и тд -->
</Defs>